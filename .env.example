# Supabase → Project Settings → Database → Connection string
# Pooler (transaction mode, porta 6543) pro app:
DATABASE_URL="postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta (porta 5432) pras migrations:
DIRECT_URL="postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""
# URL pública do app (links dos e-mails)
APP_URL="http://localhost:3000"

# Resend (https://resend.com/api-keys). Sem chave, os e-mails só aparecem no console.
RESEND_API_KEY=""
EMAIL_FROM="SPOP! <nao-responda@seudominio.com>"

# Web Push (VAPID) — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="https://github.com/pedroalvesss/spop"

# Vercel Cron manda "Authorization: Bearer $CRON_SECRET" pra /api/cron/lembretes
CRON_SECRET=""

# Open Finance (opcional): aplicação criada no dashboard.pluggy.ai, com o banco ligado pelo Meu Pluggy.
# Sem elas, o card "Banco conectado" nem aparece em Ajustes.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# Só no dev local com "npm run db:dev": banco shadow das migrations
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
