# Supabase → Project Settings → Database → Connection string
# Pooler (transaction mode, porta 6543) pro app:
DATABASE_URL="postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta (porta 5432) pras migrations:
DIRECT_URL="postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""
# URL pública do app (links dos e-mails)
APP_URL="http://localhost:3000"

# Resend (https://resend.com/api-keys). Sem chave, os e-mails só aparecem no console.
RESEND_API_KEY=""
EMAIL_FROM="SPOP! <nao-responda@seudominio.com>"
